pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code from GitHub...'
            }
        }
        stage('Build') {
            steps {
                echo 'Building the application...'
                sh 'echo "Hello, Jenkins CI/CD!"'
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests successfully...'
            }
        }
    }
    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
